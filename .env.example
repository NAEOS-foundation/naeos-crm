DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naeos_crm
NODE_ENV=development
PORT=3000
AUTH_SECRET=replace-with-a-random-32-plus-character-secret
AUTH_DISABLED=false
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-15-plus-character-password
CORS_ORIGINS=https://crm.naeos.dev,https://naeos.dev
INTELLIGENCE_API_URL=http://localhost:8080
# Comma-separated owner/name references approved for analysis by CRM admins.
INTELLIGENCE_ALLOWED_REPOSITORIES=
# Pre-issued service JWT with only intelligence:write and intelligence:read scopes.
INTELLIGENCE_SERVICE_TOKEN=
