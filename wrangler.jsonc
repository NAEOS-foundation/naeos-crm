{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naeos-crm",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-25",
  "routes": [],
  "vars": {
    "API_ORIGIN": "https://naeos-crm-api-production.up.railway.app"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "exports": {
    "NAEOSCRMContainer": {
      "type": "durable-object",
      "state": "deleted"
    }
  }
}
