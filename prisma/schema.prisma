generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum LeadStatus {
  NEW
  QUALIFIED
  NURTURE
  DISQUALIFIED
}

enum ActivityType {
  EMAIL
  CALL
  MEETING
  TASK
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CampaignType {
  OUTBOUND
  INBOUND
  NURTURE
  EVENT
  PARTNER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignStepActionType {
  EMAIL
  CALL
  TASK
  WAIT
}

enum CampaignStepStatus {
  PENDING
  READY
  EXECUTING
  DONE
  SKIPPED
}

enum FollowUpStatus {
  OPEN
  DONE
  DEFERRED
  CANCELLED
}

enum EcosystemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContributorRole {
  DEVELOPER
  DESIGNER
  REVIEWER
  MAINTAINER
  ADVISOR
}

enum PartnerType {
  TECHNOLOGY
  INTEGRATION
  STRATEGIC
  CHANNEL
  RESELLER
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum GoGateStatus {
  READY
  WAITING_FOR_GO
  APPROVED
  EXECUTING
  EXECUTED
  FAILED
  EXPIRED
  REJECTED
}

enum GoGateActionType {
  SEND_EMAIL
  SEND_MESSAGE
  PUBLISH_POST
  CONTACT_PROSPECT
  CREATE_ISSUE
  TRIGGER_WORKFLOW
  MODIFY_EXTERNAL_SYSTEM
}

enum InvestorType {
  ANGEL
  SEED
  VENTURE
  STRATEGIC
  OTHER
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  roles     UserRole[]
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ownedCompanies   Company[]   @relation("CompanyOwner")
  ownedLeads       Lead[]      @relation("LeadOwner")
  assignedTasks    Task[]      @relation("TaskAssignee")
  authoredActivities Activity[] @relation("ActivityAuthor")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  ownedCampaigns   Campaign[]  @relation("CampaignOwner")
  ownedFollowUps   FollowUp[]  @relation("FollowUpOwner")
  ownedContributors Contributor[] @relation("ContributorOwner")
  ownedPartners     Partner[]     @relation("PartnerOwner")
  ownedCommunities  Community[]   @relation("CommunityOwner")
  ownedInvestors    Investor[]    @relation("InvestorOwner")
  ownedUseCases     UseCase[]     @relation("UseCaseOwner")
}

model Company {
  id        String        @id @default(cuid())
  name      String
  industry  String?
  region    String?
  status    CompanyStatus @default(ACTIVE)
  ownerId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner      User?        @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts   Contact[]
  leads      Lead[]
  activities Activity[]
  tasks      Task[]
  opportunities Opportunity[]

  @@index([ownerId])
  @@index([status])
  @@index([name])
}

model Contact {
  id        String        @id @default(cuid())
  companyId String
  fullName  String
  email     String?
  role      String?
  status    ContactStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([companyId])
  @@index([status])
}

model Lead {
  id        String     @id @default(cuid())
  companyId String
  source    String
  status    LeadStatus @default(NEW)
  ownerId   String?
  score     Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id])

  @@index([companyId])
  @@index([ownerId])
  @@index([status])
}

model Activity {
  id         String       @id @default(cuid())
  companyId  String?
  contactId  String?
  type       ActivityType
  channel    String?
  summary    String
  occurredAt DateTime
  ownerId    String?
  createdAt  DateTime     @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?    @relation("ActivityAuthor", fields: [ownerId], references: [id])

  followUps FollowUp[]

  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
  @@index([occurredAt])
}

model Task {
  id         String     @id @default(cuid())
  companyId  String?
  assigneeId String?
  subject    String
  dueAt      DateTime?
  status     TaskStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  company  Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([companyId])
  @@index([assigneeId])
  @@index([status])
}

model AuditEvent {
  id            String      @id @default(cuid())
  actorId       String?
  actorType     String?
  action        String
  entityType    String
  entityId      String
  requestId     String?
  source        String?
  result        AuditResult
  reason        String?
  policyVersion String?
  previousState Json?
  newState      Json?
  authorization Json?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([requestId])
  @@index([createdAt])
}

model PipelineStage {
  id          String           @id @default(cuid())
  stage       OpportunityStage @unique
  name        String           @unique
  sequence    Int              @unique
  probability Int              @default(20)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sequence])
}

model Opportunity {
  id        String           @id @default(cuid())
  companyId String
  name      String
  stage     OpportunityStage @default(NEW)
  amount    Decimal          @default(0) @db.Decimal(14, 2)
  closeDate DateTime?
  ownerId   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])
  useCases UseCase[]

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([closeDate])
}

model Campaign {
  id        String         @id @default(cuid())
  name      String
  type      CampaignType   @default(OUTBOUND)
  status    CampaignStatus @default(DRAFT)
  ownerId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner User?          @relation("CampaignOwner", fields: [ownerId], references: [id])
  steps CampaignStep[]

  @@index([ownerId])
  @@index([status])
}

model CampaignStep {
  id          String                  @id @default(cuid())
  campaignId  String
  sequence    Int
  actionType  CampaignStepActionType
  subject     String?
  scheduledAt DateTime?
  status      CampaignStepStatus      @default(PENDING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sequence])
  @@index([campaignId])
  @@index([status])
}

model FollowUp {
  id         String         @id @default(cuid())
  activityId String
  dueAt      DateTime
  status     FollowUpStatus @default(OPEN)
  ownerId    String?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  owner    User?    @relation("FollowUpOwner", fields: [ownerId], references: [id])

  @@index([activityId])
  @@index([ownerId])
  @@index([status])
  @@index([dueAt])
}

model Contributor {
  id          String           @id @default(cuid())
  name        String
  role        ContributorRole
  status      EcosystemStatus  @default(ACTIVE)
  communityId String?
  ownerId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  owner     User?      @relation("ContributorOwner", fields: [ownerId], references: [id])

  @@index([communityId])
  @@index([ownerId])
  @@index([status])
}

model Partner {
  id          String          @id @default(cuid())
  name        String
  partnerType PartnerType
  status      EcosystemStatus @default(ACTIVE)
  ownerId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner User? @relation("PartnerOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
  @@index([partnerType])
}

model Community {
  id        String          @id @default(cuid())
  name      String          @unique
  purpose   String?
  status    EcosystemStatus @default(ACTIVE)
  ownerId   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  owner        User?          @relation("CommunityOwner", fields: [ownerId], references: [id])
  contributors Contributor[]

  @@index([ownerId])
  @@index([status])
}

model Investor {
  id           String          @id @default(cuid())
  name         String
  investorType InvestorType
  status       EcosystemStatus @default(ACTIVE)
  ownerId      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner User? @relation("InvestorOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
  @@index([investorType])
}

model UseCase {
  id            String     @id @default(cuid())
  opportunityId String
  title         String
  summary       String?
  value         Decimal?   @db.Decimal(14, 2)
  ownerId       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  owner       User?       @relation("UseCaseOwner", fields: [ownerId], references: [id])

  @@index([opportunityId])
  @@index([ownerId])
}

model PolicyRule {
  id            String       @id @default(cuid())
  resource      String
  action        String
  role          String
  effect        PolicyEffect
  priority      Int          @default(0)
  enabled       Boolean      @default(true)
  policyVersion String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([resource, action])
  @@index([role])
  @@index([enabled])
  @@index([policyVersion])
}

model GoGateRequest {
  id               String             @id @default(cuid())
  actionType       GoGateActionType
  target           String
  payload          Json?
  status           GoGateStatus       @default(READY)
  policyVersion    String?
  reason           String?
  requestedBy      String?
  approvedBy       String?
  expiresAt        DateTime?
  executedAt       DateTime?
  verifiedAt       DateTime?
  providerResponse Json?
  result           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([requestedBy])
  @@index([actionType])
  @@index([createdAt])
}
